---
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import { imageShadowStyle, textShadowStyle } from '../lib/shadows';
interface Props { card: CollectionEntry<'projectCards'>; dialogId: string }
const { card, dialogId } = Astro.props;
const { title, details, description, image, imageAlt, screenshots, projectUrl, author, duration } = card.data;
const { shadows } = card.data;
const shots = screenshots.length ? screenshots : image ? [{ image, alt: imageAlt, caption: '', shadowIntensity: shadows.image, captionShadowIntensity: 0 }] : [];
const href = projectUrl && /^https?:\/\//i.test(projectUrl) ? projectUrl : undefined;
---
<dialog id={dialogId} class="project-dialog" aria-labelledby={`${dialogId}-title`}>
  <div class="project-dialog__layout">
    <header class="project-dialog__header">
      <h2 id={`${dialogId}-title`} style={textShadowStyle(shadows.dialogTitle)}>{title}</h2>
      <form method="dialog"><button class="project-dialog__close" type="submit" aria-label="Projektfenster schließen" autofocus>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button></form>
    </header>
    <div class="project-dialog__body">
      <section class="project-dialog__gallery" aria-label={screenshots.length ? 'Screenshots' : 'Projektvorschau'}>
        <h3 style={textShadowStyle(shadows.galleryHeading)}>{screenshots.length ? 'Screenshots' : 'Projektvorschau'}</h3>
        {shots.length ? (
          <div>
            {shots.map((shot, index) => <figure class="project-dialog__shot" data-project-shot={index} hidden={index !== 0}>
              <div class="project-dialog__image" style={imageShadowStyle(shot.shadowIntensity)}><ResponsiveImage src={shot.image} alt={shot.alt?.trim() || `${title} – ${screenshots.length ? 'Screenshot' : 'Vorschau'} ${index + 1}`} sizes="(max-width: 760px) calc(100vw - 64px), 640px" loading="lazy" /></div>
              {shot.caption && <figcaption style={textShadowStyle(shot.captionShadowIntensity)}>{shot.caption}</figcaption>}
            </figure>)}
            {shots.length > 1 && <div class="project-dialog__thumbnails" aria-label="Screenshot auswählen">
              {shots.map((shot, index) => <button type="button" data-project-thumbnail={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={`Screenshot ${index + 1}${shot.caption ? `: ${shot.caption}` : ''} anzeigen`}>
                <ResponsiveImage src={shot.image} alt="" sizes="88px" loading="lazy" style={imageShadowStyle(shot.shadowIntensity)} /><span style={textShadowStyle(shadows.screenshotNumber)}>{index + 1}</span>
              </button>)}
            </div>}
          </div>
        ) : <p class="project-dialog__empty" style={textShadowStyle(shadows.emptyGallery)}>Für dieses Projekt sind noch keine Screenshots hinterlegt.</p>}
      </section>
      <section class="project-dialog__description" aria-label="Projektdetails">
        <h3 style={textShadowStyle(shadows.detailsHeading)}>Beschreibung</h3>
        {(details?.trim() || description?.trim()) && <p class="project-dialog__text" style={textShadowStyle(shadows.details)}>{details?.trim() || description}</p>}
        {(author || duration) && <dl class="project-dialog__meta">
          {author && <div><dt style={textShadowStyle(shadows.authorLabel)}>Autor</dt><dd style={textShadowStyle(shadows.dialogAuthor)}>{author}</dd></div>}
          {duration && <div><dt style={textShadowStyle(shadows.durationLabel)}>Zeitangabe</dt><dd style={textShadowStyle(shadows.dialogDuration)}>{duration}</dd></div>}
        </dl>}
        {href && <a class="project-dialog__link" href={href} style={textShadowStyle(shadows.projectLink)} target="_blank" rel="noopener noreferrer">Zum Projekt <span aria-hidden="true">↗</span></a>}
      </section>
    </div>
  </div>
</dialog>

<style>
  .project-dialog { width: 1200px; height: 700px; max-width: calc(100vw - 32px); max-height: calc(100dvh - 32px); padding: 0; margin: auto; border: 1px solid #d9ded5; border-radius: 18px; background: #f7f6f2; color: #202b27; box-shadow: 0 24px 80px rgb(0 0 0 / 25%); overflow: hidden; }
  .project-dialog::backdrop { background: rgb(12 22 17 / 65%); }
  .project-dialog__layout { height: 100%; display: flex; flex-direction: column; }
  .project-dialog__header { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 28px; border-bottom: 1px solid #d9ded5; }
  .project-dialog__header h2 { margin: 0; font-size: clamp(1.25rem, 2.5vw, 1.75rem); line-height: 1.3; overflow-wrap: anywhere; }
  .project-dialog__close { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid #d9ded5; border-radius: 50%; background: #fff; color: inherit; cursor: pointer; }
  .project-dialog__close svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; }
  .project-dialog__body { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; padding: 24px 28px 32px; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .project-dialog__body section { min-width: 0; }
  .project-dialog__body h3 { font-size: 1.1rem; margin: 0 0 16px; }
  .project-dialog__shot { margin: 0; }
  .project-dialog__shot[hidden] { display: none; }
  .project-dialog__image { height: 360px; max-height: 45dvh; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); place-items: center; background: #e9ede5; border-radius: 12px; overflow: hidden; }
  .project-dialog__image img { display: block; width: 100%; height: 100%; object-fit: contain; min-height: 0; }
  .project-dialog__shot figcaption { font-size: .85rem; color: #526057; margin-top: 8px; overflow-wrap: anywhere; }
  .project-dialog__thumbnails { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .project-dialog__thumbnails button { width: 88px; height: 64px; position: relative; padding: 3px; border: 2px solid transparent; border-radius: 8px; background: #e9ede5; cursor: pointer; }
  .project-dialog__thumbnails button[aria-pressed="true"] { border-color: #32664b; }
  .project-dialog__thumbnails img { display: block; width: 100%; height: 100%; object-fit: contain; border-radius: 4px; }
  .project-dialog__thumbnails span { position: absolute; bottom: 2px; right: 3px; padding-inline: 4px; border-radius: 3px; background: #fff; font-size: .7rem; }
  .project-dialog__text { margin: 0 0 24px; white-space: pre-line; overflow-wrap: anywhere; color: #526057; }
  .project-dialog__empty { color: #526057; }
  .project-dialog__meta { display: grid; gap: 12px; font-size: .9rem; margin: 0 0 24px; }
  .project-dialog__meta dt { font-weight: 700; }
  .project-dialog__meta dd { margin: 0; color: #526057; overflow-wrap: anywhere; }
  .project-dialog__link { display: inline-flex; gap: 16px; align-items: center; padding: 12px 18px; border-radius: 8px; background: #32664b; color: #fff; text-decoration: none; font-weight: 700; }
  .project-dialog button:focus-visible { outline: 3px solid #32664b; outline-offset: 3px; }
  :global(html.project-modal-open) { overflow: hidden; scroll-snap-type: none; }
  @media (max-width: 760px) {
    .project-dialog__header { padding: 16px; }
    .project-dialog__body { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 20px 16px; }
    .project-dialog__image { height: 240px; }
  }
</style>
