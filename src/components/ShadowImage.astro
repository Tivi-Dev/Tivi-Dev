---
import { imageShadowStyle } from '../lib/shadows';
import { withBasePath } from '../lib/site-url';
interface Props { image: string; alt?: string; intensity?: number }
const { image, alt = '', intensity = 50 } = Astro.props;
---
<figure class="shadow-image" style={imageShadowStyle(intensity)}>
  <img src={withBasePath(image)} alt={alt} loading="lazy" />
</figure>
<style>
  .shadow-image { margin: 24px 0; }
  .shadow-image img { display: block; max-width: 100%; height: auto; }
</style>
