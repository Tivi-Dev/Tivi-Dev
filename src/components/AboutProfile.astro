---
import type { CollectionEntry } from 'astro:content';
import { aboutIcons } from '../lib/about-icons';
import Markdoc from '@markdoc/markdoc';

interface Props {
  photo?: string | null;
  photoAlt?: string;
  topics: CollectionEntry<'ueberMich'>['data']['topics'];
}
const { photo, photoAlt, topics } = Astro.props;
const entries = ['profile', 'education', 'hobbies', 'skills', 'achievements', 'experience'] as const;
const lineColors = entries.map((key) => `--line-${key}: ${topics[key].lineColor}`).join('; ');
const markdocConfig = { tags: { Unterstrichen: { render: 'u' } } };
const renderText = (text: string) => {
  const ast = Markdoc.parse(text);
  const errors = Markdoc.validate(ast, markdocConfig);
  if (errors.some(({ error }) => error.level === 'critical' || error.level === 'error')) {
    throw new Error('Ungültiger Über-mich-Text: ' + JSON.stringify(errors));
  }
  return Markdoc.renderers.html(Markdoc.transform(ast, markdocConfig));
};
---
<div class="profile-map" style={lineColors}>
  <svg class="profile-map__connections" viewBox="0 0 1000 668" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M410 245 310 145H170" style="stroke: var(--line-profile)" />
    <path d="M590 245 690 145H830" style="stroke: var(--line-education)" />
    <path d="M630 334H830" style="stroke: var(--line-skills)" />
    <path d="M380 390 280 490H160" style="stroke: var(--line-achievements)" />
    <path d="M370 334H170" style="stroke: var(--line-hobbies)" />
    <path d="M595 425 730 570H830" style="stroke: var(--line-experience)" />
  </svg>
  <div class="profile-map__portrait">
    {photo ? (
      <img src={photo} alt={photoAlt ?? ''} width="800" height="800" loading="lazy" />
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 21v-2a7 7 0 0 1 14 0v2" />
      </svg>
    )}
  </div>
  {entries.map((key) => (
    <section class={`profile-map__topic profile-map__topic--${key}`} aria-labelledby={`about-${key}-title`} style={`--topic-line-color: var(--line-${key})`}>
      <h3 id={`about-${key}-title`}>
        {topics[key].icon !== 'none' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={aboutIcons[topics[key].icon].path} /></svg>
        )}
        {topics[key].title}
      </h3>
      {topics[key].text.trim() && <div class="profile-map__text" set:html={renderText(topics[key].text)} />}
    </section>
  ))}
</div>
<style>
  .profile-map { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr) 260px minmax(0, 1fr); grid-template-rows: minmax(180px, auto) minmax(260px, auto) minmax(180px, auto); grid-template-areas: "profile . education" "hobbies portrait skills" "achievements . experience"; gap: 24px; align-items: center; }
  .profile-map__connections { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; stroke: #32664b; stroke-width: 2; }
  .profile-map__portrait { grid-area: portrait; width: 260px; aspect-ratio: 1; padding: 9px; border: 2px solid #32664b; border-radius: 50%; background: #f7f6f2; box-shadow: 0 0 0 9px #f7f6f2; }
  .profile-map__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .profile-map__portrait > svg { width: 100%; height: 100%; padding: 35px; color: #526057; }
  .profile-map__topic { min-width: 0; width: min(100%, 290px); padding: 14px 18px; background: #f7f6f2; border-left: 2px solid var(--topic-line-color, #32664b); overflow-wrap: anywhere; }
  .profile-map__topic h3 { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; font-size: 1rem; line-height: 1.3; letter-spacing: .035em; text-transform: uppercase; color: var(--topic-line-color, #32664b); }
  .profile-map__topic h3 svg { width: 25px; height: 25px; flex-shrink: 0; }
  .profile-map__topic--profile { grid-area: profile; justify-self: start; }
  .profile-map__topic--experience { grid-area: experience; justify-self: end; align-self: end; }
  .profile-map__topic--achievements { grid-area: achievements; justify-self: start; align-self: start; }
  .profile-map__topic--education { grid-area: education; justify-self: end; }
  .profile-map__topic--skills { grid-area: skills; width: 100%; justify-self: end; }
  .profile-map__topic--hobbies { grid-area: hobbies; justify-self: start; }
  .profile-map__text { color: var(--topic-line-color, #32664b); font-size: .95rem; line-height: 1.65; }
  .profile-map__text :global(p) { margin: 0 0 12px; }
  .profile-map__text :global(article > :last-child) { margin-bottom: 0; }
  .profile-map__text :global(a) { color: inherit; }
  .profile-map__text :global(ul), .profile-map__text :global(ol) { padding-left: 20px; margin: 0 0 12px; }
  .profile-map__text :global(h4), .profile-map__text :global(h5), .profile-map__text :global(h6) { font-size: 1rem; margin: 16px 0 8px; }
  .profile-map__text :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  .profile-map__text :global(th), .profile-map__text :global(td) { border: 1px solid #d9ded5; padding: 6px; }
  .profile-map__text :global(pre) { overflow-x: auto; }
  @media (max-width: 1100px) {
    .profile-map { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto; grid-template-areas: "portrait portrait" "profile education" "hobbies skills" "achievements experience"; gap: 24px; align-items: start; }
    .profile-map__connections { display: none; }
    .profile-map__portrait { justify-self: center; width: min(260px, 70vw); margin-bottom: 12px; }
    .profile-map__topic { width: 100%; margin: 0; justify-self: stretch; align-self: stretch; padding: 18px; border-radius: 0 12px 12px 0; background: #fffefa; }
  }
  @media (max-width: 600px) {
    .profile-map { grid-template-columns: minmax(0, 1fr); grid-template-areas: "portrait" "profile" "education" "hobbies" "skills" "achievements" "experience"; gap: 18px; }
  }
</style>
