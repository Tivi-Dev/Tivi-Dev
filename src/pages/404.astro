---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBasePath } from '../lib/site-url';
const siteName = (await getEntry('homepage', 'homepage'))?.data.title.trim() || 'Portfolio';
---
<BaseLayout title={`Seite nicht gefunden · ${siteName}`} description="Diese Seite existiert nicht.">
  <section class="hero">
    <p class="eyebrow" data-shadow-text="not-found-code">404</p>
    <h1 data-shadow-text="not-found-heading">Hier ist noch nichts.</h1>
    <p class="intro"><a href={withBasePath('/')} data-shadow-text="not-found-link">Zur Startseite</a></p>
  </section>
</BaseLayout>
