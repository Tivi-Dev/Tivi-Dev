---
import { getEntry, render } from 'astro:content';
import PrivacyBlocks from '../components/PrivacyBlocks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBasePath } from '../lib/site-url';
import { textShadowStyle } from '../lib/shadows';

export function getStaticPaths() {
  return [
    { page: 'skills', title: 'Skills' },
    { page: 'projekte', title: 'Projekte' },
    { page: 'ueber-mich', title: 'Über Mich' },
    { page: 'kontakt', title: 'Kontakt' },
    { page: 'impressum', title: 'Impressum' },
    { page: 'datenschutz', title: 'Datenschutz' },
  ].map(({ page, title }) => ({ params: { page }, props: { title } }));
}

const { title } = Astro.props;
const page = Astro.params.page ?? '';
if (['skills', 'projekte', 'ueber-mich', 'kontakt'].includes(page)) {
  return Astro.redirect(withBasePath(`/#${page}`));
}
// Same site name as the start page's title, so every browser tab reads "<page> · <site>".
const siteName = (await getEntry('homepage', 'homepage'))?.data.title.trim() || 'Portfolio';
const privacyEntry = page === 'datenschutz' ? await getEntry('privacy', 'datenschutz') : null;
const legalEntry = page === 'datenschutz' ? null : await getEntry('legal', page);
const legalTitle = privacyEntry?.data.title.trim() || legalEntry?.data.title.trim() || title;
const hasLegalContent = Boolean(legalEntry?.body?.trim());
const Content = legalEntry && hasLegalContent ? (await render(legalEntry)).Content : null;
const description = page === 'datenschutz'
  ? `${legalTitle} von ${siteName}: welche Daten beim Besuch und bei der Kontaktaufnahme verarbeitet werden und welche Rechte Sie haben.`
  : `${legalTitle} von ${siteName}: Angaben zum Anbieter dieser Website und Kontaktmöglichkeit.`;
---
<BaseLayout title={`${legalTitle} · ${siteName}`} description={description}>
  <section class="hero">
    <h1 class="legal-page-title" style={textShadowStyle(privacyEntry?.data.titleShadow ?? legalEntry?.data.titleShadow)}>{legalTitle}</h1>
    {privacyEntry ? (
      <PrivacyBlocks blocks={privacyEntry.data.blocks} />
    ) : Content ? (
      <div class="prose legal-content content-card" style={textShadowStyle(legalEntry?.data.textShadow)}><Content /></div>
    ) : (
      <p class="intro" style={textShadowStyle(legalEntry?.data.textShadow)}>
        Es ist noch kein Text hinterlegt. Du kannst ihn in Keystatic unter
        „{legalTitle}“ im Feld „Inhalt“ eintragen.
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .hero .legal-page-title { font-size: clamp(1.4rem, 3.5vw, 3rem); }
  @media (max-width: 1100px) {
    .hero .legal-page-title { font-size: clamp(1rem, 2.5vw, 1.75rem); }
  }
</style>
