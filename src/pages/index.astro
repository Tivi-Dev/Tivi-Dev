---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import ueberMich from '../content/ueber-mich.json';

interface AboutPageContent {
  photo?: string | null;
  photoAlt?: string;
  content: {
    text: string;
    style: string;
    fontSize?: number | null;
    bold: boolean;
    italic: boolean;
    underline: boolean;
    spaceBefore: number;
    spaceAfter: number;
  }[];
  gallery: {
    image?: string | null;
    imageAlt?: string;
    caption?: string;
  }[];
}

const aboutPage: AboutPageContent = ueberMich;
const homepage = await getEntry('homepage', 'homepage');
if (!homepage) throw new Error('Die Startseiten-Inhalte fehlen.');
const skills = await getEntry('skills', 'skills');
const frontendCardsRaw = await getCollection('frontendCards');
const backendCardsRaw = await getCollection('backendCards');
const projectCards = await getCollection('projectCards');
const { title, description, photo, photoAlt, content } = homepage.data;
const hasGalleryImages = aboutPage.gallery.some((item) => Boolean(item.image));
const firstGalleryImage = aboutPage.gallery.find((item) => item.image)?.image ?? photo ?? '';

const sortCardsByOrder = (
  sectionCards: typeof frontendCardsRaw | typeof backendCardsRaw,
  orderedIds: string[],
) => {
  if (!orderedIds.length) return sectionCards;
  const cardMap = new Map(sectionCards.map((card) => [card.id, card]));
  const orderedCards = orderedIds
    .map((id) => cardMap.get(id))
    .filter((card): card is typeof sectionCards[number] => Boolean(card));
  const unorderedCards = sectionCards.filter((card) => !orderedIds.includes(card.id));
  return [...orderedCards, ...unorderedCards];
};

const frontendCards = sortCardsByOrder(
  frontendCardsRaw,
  skills?.data.frontendOrder ?? [],
);
const backendCards = sortCardsByOrder(
  backendCardsRaw,
  skills?.data.backendOrder ?? [],
);
---
<BaseLayout title={title} description={description} presentation>
  <section id="home" class="home-split slide" aria-label="Home">
    <h2 class="page-title">Home</h2>
    <div class="home-text">
      <div class="prose home-content">
        {content.map(line => {
          const className = `home-line home-line--${line.style}`;
          const style = [
            `--space-before: ${line.spaceBefore}px`,
            `--space-after: ${line.spaceAfter}px`,
            line.fontSize ? `--line-font-size: ${line.fontSize}px` : '',
            line.bold ? 'font-weight: 800' : '',
            line.italic ? 'font-style: italic' : '',
            line.underline ? 'text-decoration: underline' : '',
          ].filter(Boolean).join('; ');
          if (line.style === 'heading1') return <h1 class={className} style={style}>{line.text}</h1>;
          if (line.style === 'heading2') return <h2 class={className} style={style}>{line.text}</h2>;
          if (line.style === 'heading3') return <h3 class={className} style={style}>{line.text}</h3>;
          return <p class={className} style={style}>{line.text}</p>;
        })}
      </div>
    </div>
    <div class="home-photo">
      {photo ? (
        <img src={photo} alt={photoAlt ?? ''} width="800" height="1000" fetchpriority="high" />
      ) : (
        <div class="photo-placeholder" aria-hidden="true"></div>
      )}
    </div>
  </section>
  <section id="skills" class="slide skills-slide" aria-label="Skills">
    <h2 class="page-title">Skills</h2>
    <section class="skills-area" aria-labelledby="frontend-title">
      <h2 id="frontend-title">Frontend</h2>
      <div class="skill-cards">
        {frontendCards.map(card => <SkillCard card={card} />)}
      </div>
    </section>
    <section class="skills-area" aria-labelledby="backend-title">
      <h2 id="backend-title">Backend</h2>
      <div class="skill-cards">
        {backendCards.map(card => <SkillCard card={card} />)}
      </div>
    </section>
  </section>
  <section id="projekte" class="slide text-slide projects-slide" aria-labelledby="projekte-title">
    <div>
      <h2 id="projekte-title" class="page-title">Projekte</h2>
      <div class="project-cards">
        {projectCards.map(card => <ProjectCard card={card} />)}
      </div>
    </div>
  </section>
  <section id="ueber-mich" class="slide text-slide about-slide" aria-labelledby="ueber-mich-title">
    <div>
      <h2 id="ueber-mich-title" class="page-title">Über Mich</h2>
      <div class="about-layout">
        <div class="about-photo">
          {aboutPage.photo ? (
            <img src={aboutPage.photo} alt={aboutPage.photoAlt ?? ''} width="800" height="800" loading="lazy" />
          ) : (
            <div class="content-card" aria-hidden="true">Foto folgt</div>
          )}
        </div>
        <div class="content-card about-content">
          {aboutPage.content.map(line => {
            const className = `about-line about-line--${line.style}`;
            const style = [
              `--space-before: ${line.spaceBefore}px`,
              `--space-after: ${line.spaceAfter}px`,
              line.fontSize ? `--line-font-size: ${line.fontSize}px` : '',
              line.bold ? 'font-weight: 800' : '',
              line.italic ? 'font-style: italic' : '',
              line.underline ? 'text-decoration: underline' : '',
            ].filter(Boolean).join('; ');
            if (line.style === 'heading1') return <h1 class={className} style={style}>{line.text}</h1>;
            if (line.style === 'heading2') return <h2 class={className} style={style}>{line.text}</h2>;
            if (line.style === 'heading3') return <h3 class={className} style={style}>{line.text}</h3>;
            return <p class={className} style={style}>{line.text}</p>;
          })}
        </div>
      </div>
      {Boolean(aboutPage.gallery.length) && (
        <div class="about-gallery" aria-label="Fotostrecke">
          {aboutPage.gallery.map((item) => item.image && (
            <figure class="content-card about-gallery__item">
              <button
                class="about-gallery__trigger"
                type="button"
                data-gallery-image={item.image}
                data-gallery-alt={item.imageAlt ?? ''}
                data-gallery-caption={item.caption ?? ''}
                aria-label={`Bild vergrößern${item.caption ? `: ${item.caption}` : ''}`}
              >
                <img src={item.image} alt={item.imageAlt ?? ''} loading="lazy" />
              </button>
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
  <section id="kontakt" class="slide text-slide" aria-labelledby="kontakt-title">
    <div>
      <h2 id="kontakt-title" class="page-title">Kontakt</h2>
      <form class="contact-form" data-contact-form>
        <label>
          <span>Name</span>
          <input name="from_name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>E-Mail-Adresse</span>
          <input name="reply_to" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Betreff</span>
          <input name="subject" type="text" required />
        </label>
        <label>
          <span>Nachricht</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button type="submit">Nachricht senden</button>
        <p class="contact-form__status" data-contact-status aria-live="polite"></p>
      </form>
    </div>
  </section>
  {hasGalleryImages && (
    <div class="gallery-lightbox" hidden data-gallery-lightbox>
      <div class="gallery-lightbox__backdrop" data-gallery-close></div>
      <figure class="gallery-lightbox__content">
        <Image src={firstGalleryImage} alt="" width={1200} height={900} data-gallery-preview />
        <figcaption data-gallery-caption></figcaption>
        <button class="gallery-lightbox__close" type="button" data-gallery-close aria-label="Vollbild schließen">×</button>
      </figure>
    </div>
  )}
</BaseLayout>

<script>
  const presentation = document.querySelector<HTMLElement>('.presentation');
  if (presentation) {
    const slides = [...presentation.querySelectorAll<HTMLElement>('.slide')];
    if (!slides.length) throw new Error('Für den Präsentationsmodus wurden keine Slides gefunden.');

    const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
    const header = document.querySelector<HTMLElement>('.site-header');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const presentationQuery = window.matchMedia('(min-width: 1101px) and (pointer: fine)');
    const canUsePresentation = () => presentationQuery.matches && !reducedMotionQuery.matches;
    const initialHash = location.hash;
    let pendingInitialAlignment = Boolean(initialHash);
    let frame = 0;
    let currentIndex = 0;
    let isNavigating = false;
    let unlockTimer = 0;
    let wheelDelta = 0;
    let wheelResetTimer = 0;

    const getScrollBehavior = (): ScrollBehavior => (reducedMotionQuery.matches ? 'auto' : 'smooth');
    const scrollToSection = (hash: string, behavior: ScrollBehavior) => {
      const section = document.querySelector<HTMLElement>(hash);
      if (!section) return;
      const top = section.getBoundingClientRect().top + window.scrollY - (header?.offsetHeight ?? 0);
      window.scrollTo({ top, behavior });
    };
    const goToSlide = (targetIndex: number) => {
      const nextIndex = Math.max(0, Math.min(targetIndex, slides.length - 1));
      if (isNavigating) return;
      currentIndex = nextIndex;
      isNavigating = true;
      clearTimeout(unlockTimer);
      scrollToSection(`#${slides[currentIndex].id}`, getScrollBehavior());
      unlockTimer = window.setTimeout(() => {
        isNavigating = false;
        updateActive();
      }, reducedMotionQuery.matches ? 80 : 650);
    };
    const navigateBy = (offset: number) => {
      goToSlide(currentIndex + offset);
    };
    const updateActive = () => {
      if (isNavigating) { frame = 0; return; }
      const top = header?.getBoundingClientRect().bottom ?? 0;
      const active = slides.find((slide) => {
        const bounds = slide.getBoundingClientRect();
        return bounds.top <= top + 2 && bounds.bottom > top + 2;
      }) ?? slides[0];
      const index = slides.indexOf(active);
      if (index >= 0) currentIndex = index;
      links.forEach(link => {
        if (link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (!pendingInitialAlignment && location.hash !== `#${active.id}`) history.replaceState(null, '', `#${active.id}`);
      frame = 0;
    };

    const onWheel = (event: WheelEvent) => {
      if (!canUsePresentation() || event.ctrlKey || event.metaKey || document.querySelector('[data-gallery-lightbox]:not([hidden])')) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest('textarea, input, select, .site-header, .gallery-lightbox')) return;
      const bounds = slides[currentIndex].getBoundingClientRect();
      const footerHeight = document.querySelector<HTMLElement>('.site-footer')?.offsetHeight ?? 0;
      if ((event.deltaY > 0 && bounds.bottom > window.innerHeight - footerHeight + 2)
        || (event.deltaY < 0 && bounds.top < (header?.offsetHeight ?? 0) - 2)) return;
      wheelDelta += event.deltaY;
      clearTimeout(wheelResetTimer);
      wheelResetTimer = window.setTimeout(() => { wheelDelta = 0; }, 120);
      if (Math.abs(wheelDelta) < 80) return;
      event.preventDefault();
      navigateBy(wheelDelta > 0 ? 1 : -1);
      wheelDelta = 0;
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (!canUsePresentation() || document.querySelector('[data-gallery-lightbox]:not([hidden])')) return;
      const target = event.target as HTMLElement | null;
      if (target && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A'].includes(target.tagName))) return;

      if (event.key === 'ArrowDown' || event.key === 'PageDown' || event.key === ' ') {
        event.preventDefault();
        navigateBy(1);
      } else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
        event.preventDefault();
        navigateBy(-1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goToSlide(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goToSlide(slides.length - 1);
      }
    };

    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(updateActive);
    }, { passive: true });
    window.addEventListener('hashchange', () => {
      const targetIndex = slides.findIndex(slide => `#${slide.id}` === location.hash);
      if (targetIndex >= 0) goToSlide(targetIndex);
    });
    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKeyDown);

    links.forEach(link => link.addEventListener('click', event => {
      if (!link.hash || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const targetIndex = slides.findIndex(slide => `#${slide.id}` === link.hash);
      if (targetIndex < 0) return;
      event.preventDefault();
      goToSlide(targetIndex);
    }));

    if (initialHash) {
      const targetIndex = slides.findIndex(slide => `#${slide.id}` === initialHash);
      if (targetIndex >= 0) {
        currentIndex = targetIndex;
        const alignInitialSection = () => {
          scrollToSection(initialHash, 'instant');
          requestAnimationFrame(() => {
            pendingInitialAlignment = false;
            updateActive();
          });
        };
        if (document.readyState === 'complete') void document.fonts.ready.then(alignInitialSection);
        else window.addEventListener('load', () => { void document.fonts.ready.then(alignInitialSection); }, { once: true });
      }
    }
    if (!initialHash) updateActive();
  }

  const galleryLightbox = document.querySelector<HTMLElement>('[data-gallery-lightbox]');
  const galleryPreview = galleryLightbox?.querySelector<HTMLImageElement>('[data-gallery-preview]');
  const galleryCaption = galleryLightbox?.querySelector<HTMLElement>('[data-gallery-caption]');
  const galleryTriggers = document.querySelectorAll<HTMLButtonElement>('.about-gallery__trigger');
  const galleryCloseControls = galleryLightbox?.querySelectorAll<HTMLElement>('[data-gallery-close]');

  const closeGalleryLightbox = () => {
    if (!galleryLightbox) return;
    galleryLightbox.hidden = true;
    document.body.style.overflow = '';
  };

  if (galleryLightbox && galleryPreview && galleryCaption && galleryTriggers.length) {
    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const image = trigger.dataset.galleryImage;
        if (!image) return;
        galleryPreview.srcset = '';
        galleryPreview.src = image;
        galleryPreview.alt = trigger.dataset.galleryAlt ?? '';
        galleryCaption.textContent = trigger.dataset.galleryCaption ?? '';
        galleryLightbox.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    });

    galleryCloseControls?.forEach((control) => {
      control.addEventListener('click', closeGalleryLightbox);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !galleryLightbox.hidden) {
        closeGalleryLightbox();
      }
    });
  }
</script>

<script>
  import emailjs from '@emailjs/browser';

  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const contactStatus = document.querySelector<HTMLElement>('[data-contact-status]');

  if (contactForm && contactStatus) {
    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        return;
      }

      const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!submitButton) throw new Error('Der Senden-Button des Kontaktformulars fehlt.');

      submitButton.disabled = true;
      contactStatus.textContent = 'Nachricht wird gesendet …';
      contactStatus.dataset.state = 'pending';

      try {
        await emailjs.sendForm('service_85uq3rn', 'template_xydiaar', contactForm, {
          publicKey: 'QhemBjtENsSglwf7j',
        });
        contactForm.reset();
        contactStatus.textContent = 'Vielen Dank! Deine Nachricht wurde gesendet.';
        contactStatus.dataset.state = 'success';
      } catch (error) {
        console.error('EmailJS konnte die Kontaktanfrage nicht senden.', error);
        contactStatus.textContent = 'Die Nachricht konnte nicht gesendet werden. Bitte versuche es später erneut.';
        contactStatus.dataset.state = 'error';
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
