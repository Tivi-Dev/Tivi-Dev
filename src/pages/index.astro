---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import { skillGroups } from '../lib/skill-groups';
import AboutProfile from '../components/AboutProfile.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { coverScale, publicImageSize } from '../lib/responsive-images';
import { imageShadowStyle, textShadowStyle } from '../lib/shadows';
import { absoluteUrl } from '../lib/site-url';

const aboutEntry = await getEntry('ueberMich', 'ueber-mich');
if (!aboutEntry) throw new Error('Die Über-mich-Inhalte fehlen.');
const aboutPage = aboutEntry.data;
const homepage = await getEntry('homepage', 'homepage');
if (!homepage) throw new Error('Die Startseiten-Inhalte fehlen.');
const skills = await getEntry('skills', 'skills');
const contactPage = await getEntry('kontakt', 'kontakt');
const contactHeading = contactPage?.data.heading ?? 'Schreib mir eine Nachricht';
const skillCards = await getCollection('skillCards');
const projectCards = await getCollection('projectCards');
const { title, description, photo, photoAlt, photoSettings, content } = homepage.data;
// Consecutive H1 lines (e.g. "Sergey" and "Fokin") form one heading; every line stays its own block.
type HomeLine = typeof content[number];
const homeBlocks = content.reduce<HomeLine[][]>((blocks, line) => {
  const previous = blocks.at(-1);
  if (line.style === 'heading1' && previous?.[0].style === 'heading1') previous.push(line);
  else blocks.push([line]);
  return blocks;
}, []);
const homeLineStyle = (line: HomeLine) => [
  `--space-before: ${line.spaceBefore}px`,
  `--space-after: ${line.spaceAfter}px`,
  line.fontSize ? `--line-font-size: ${line.fontSize}px` : '',
  line.bold ? 'font-weight: 800' : '',
  line.italic ? 'font-style: italic' : '',
  line.underline ? 'text-decoration: underline' : '',
  textShadowStyle(line.shadowIntensity),
].filter(Boolean).join('; ');
const photoAspect = photoSettings.shape === 'circle' ? '1 / 1'
  : { portrait: '4 / 5', square: '1 / 1', landscape: '4 / 3' }[photoSettings.aspect];
const photoRadius = { rounded: '16px', rectangle: '0', circle: '50%' }[photoSettings.shape];
// The photo is drawn with object-fit: cover and zoom, so it needs more pixels than its box is wide. Box widths: up to
// 400px below 760px viewport width, otherwise half of the slide (max. 540px).
const [aspectWidth, aspectHeight] = photoAspect.split('/').map(Number);
const photoScale = photo ? coverScale(await publicImageSize(photo), aspectWidth / aspectHeight, photoSettings.zoom / 100) : 1;
const photoSizes = `(max-width: 760px) calc(min(100vw - 32px, 400px) * ${photoScale}), calc(min(50vw, 540px) * ${photoScale})`;
const photoStyle = `--photo-width: ${photoSettings.size}%; --photo-aspect: ${photoAspect}; --photo-radius: ${photoRadius}; --photo-zoom: ${photoSettings.zoom / 100}; --photo-x: ${photoSettings.positionX}%; --photo-y: ${photoSettings.positionY}%; ${imageShadowStyle(photoSettings.shadowIntensity)}`;

const skillCardMap = new Map(skillCards.map(card => [card.id, card]));
const skillSections = skillGroups.map(group => ({
  ...group,
  cards: [...new Set(skills?.data[group.id] ?? [])].flatMap(id => {
    const card = skillCardMap.get(id);
    if (!card) {
      console.warn(`Skills / ${group.title}: Die zugewiesene Karte „${id}“ fehlt und wird übersprungen. Bitte die Zuordnung in Keystatic prüfen.`);
      return [];
    }
    return [card];
  }),
}));
// Structured data only states what the page itself shows: the person named in the H1 lines and their photo.
const personName = content.filter(line => line.style === 'heading1').map(line => line.text.trim()).filter(Boolean).join(' ');
const structuredData = personName ? {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: { '@type': 'Person', name: personName, ...(photo ? { image: absoluteUrl(photo) } : {}) },
} : undefined;
---
<BaseLayout title={title} description={description} presentation structuredData={structuredData}>
  <section id="home" class="home-split slide" aria-label="Home">
    <p class="page-title" data-shadow-text="heading-home">Home</p>
    <div class="home-text">
      <div class="prose home-content">
        {homeBlocks.map(lines => {
          const [line] = lines;
          // The name is the page's only h1; the space keeps "Sergey Fokin" as two words for screen readers.
          if (line.style === 'heading1') return (
            <h1 class="home-name">
              {lines.map((nameLine, index) => <>{index > 0 && ' '}<span class={`home-line home-line--${nameLine.style}`} style={homeLineStyle(nameLine)}>{nameLine.text}</span></>)}
            </h1>
          );
          // H2/H3 in the intro are only text sizes (such as the motto); as headings they would open empty sections.
          return <p class={`home-line home-line--${line.style}`} style={homeLineStyle(line)}>{line.text}</p>;
        })}
      </div>
    </div>
    <div class="home-photo" style={photoStyle}>
      {photo ? (
        <ResponsiveImage src={photo} alt={photoAlt ?? ''} sizes={photoSizes} fetchpriority="high" />
      ) : (
        <div class="photo-placeholder" aria-hidden="true"></div>
      )}
    </div>
  </section>
  <section id="skills" class="slide skills-slide" aria-labelledby="skills-title">
    <h2 id="skills-title" class="page-title" data-shadow-text="heading-skills">Skills</h2>
    <div class="skills-groups">
      {skillSections.map(group => (
        <section class="skills-area" data-skill-group={group.id} aria-labelledby={`skills-${group.id}-title`}>
          <h3 id={`skills-${group.id}-title`} data-shadow-text={`heading-skills-${group.id}`}>{group.title}</h3>
          <ul class="skill-list" role="list" aria-labelledby={`skills-${group.id}-title`}>
            {group.cards.map(card => <SkillCard card={card} />)}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <section id="projekte" class="slide text-slide projects-slide" aria-labelledby="projekte-title">
    <div>
      <h2 id="projekte-title" class="page-title" data-shadow-text="heading-projekte">Projekte</h2>
      <div class="project-cards">
        {projectCards.map(card => <ProjectCard card={card} />)}
      </div>
    </div>
  </section>
  <section id="ueber-mich" class="slide text-slide about-slide" aria-labelledby="ueber-mich-title">
    <div>
      <h2 id="ueber-mich-title" class="page-title" data-shadow-text="heading-ueber-mich">Über Mich</h2>
      <AboutProfile photo={aboutPage.photo} photoAlt={aboutPage.photoAlt} photoShadow={aboutPage.photoShadow} topics={aboutPage.topics} />
    </div>
  </section>
  <section id="kontakt" class="slide text-slide contact-slide" aria-labelledby="kontakt-title">
    <div>
      <h2 id="kontakt-title" class="page-title" data-shadow-text="heading-kontakt">Kontakt</h2>
      <h3 id="contact-form-heading" class="contact-form-heading" style={textShadowStyle(contactPage?.data.headingShadow)}>{contactHeading}</h3>
      <form class="contact-form" data-contact-form aria-labelledby="contact-form-heading">
        <label>
          <span data-shadow-text="contact-label-name">Name</span>
          <input name="from_name" type="text" autocomplete="name" data-shadow-text="contact-input-name" required />
        </label>
        <label>
          <span data-shadow-text="contact-label-email">E-Mail-Adresse</span>
          <input name="reply_to" type="email" autocomplete="email" data-shadow-text="contact-input-email" required />
        </label>
        <label>
          <span data-shadow-text="contact-label-subject">Betreff</span>
          <input name="subject" type="text" data-shadow-text="contact-input-subject" required />
        </label>
        <label>
          <span data-shadow-text="contact-label-message">Nachricht</span>
          <textarea name="message" rows="6" data-shadow-text="contact-input-message" required></textarea>
        </label>
        <button type="submit" data-shadow-text="contact-submit">Nachricht senden</button>
        <p class="contact-form__status" data-contact-status data-shadow-text="contact-status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const presentation = document.querySelector<HTMLElement>('.presentation');
  if (presentation) {
    const slides = [...presentation.querySelectorAll<HTMLElement>('.slide')];
    if (!slides.length) throw new Error('Für den Präsentationsmodus wurden keine Slides gefunden.');

    const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
    const header = document.querySelector<HTMLElement>('.site-header');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const presentationQuery = window.matchMedia('(min-width: 1101px) and (min-height: 741px) and (pointer: fine)');
    const canUsePresentation = () => presentationQuery.matches && !reducedMotionQuery.matches;
    const slideIndexOf = (hash: string) => slides.findIndex(slide => `#${slide.id}` === hash);

    // Who controls the scroll position right now:
    // - idle: the user; the scroll listener keeps hash and aria-current in sync,
    // - aligning: initial alignment to a slide hash after fonts and layout have settled,
    // - animating: our animated change to a chosen slide,
    // - following: the browser scrolls to a non-slide fragment or a history entry (e.g. #inhalt, Back).
    // Every automatic step carries the token it was started with. A newer navigation or any user action
    // replaces the state, so stale timers and promise callbacks can no longer restore an outdated target.
    type Navigation =
      | { mode: 'idle' }
      | { mode: 'aligning' | 'following'; token: number }
      | { mode: 'animating'; token: number; target: number };
    let navigation: Navigation = { mode: 'idle' };
    let navigationToken = 0;
    // The hash as last seen or written by this script. If location.hash differs, the browser has navigated
    // (skip link, Back/Forward) and its hashchange event is still pending, so scroll syncing must wait.
    let knownHash = location.hash;
    const isCurrent = (token: number) => navigation.mode !== 'idle' && navigation.token === token;

    let frame = 0;
    let currentIndex = 0;
    let finishTimer = 0;
    let wheelDelta = 0;
    let wheelResetTimer = 0;

    const getScrollBehavior = (): ScrollBehavior => (reducedMotionQuery.matches ? 'auto' : 'smooth');
    // Distance between a slide's top edge and the bottom of the sticky header.
    const offsetOf = (slide: HTMLElement) => slide.getBoundingClientRect().top - (header?.offsetHeight ?? 0);
    // A slide counts as reached when it sits below the header, or when the page cannot scroll any further.
    const isAtSlide = (index: number) => {
      const offset = offsetOf(slides[index]);
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      return Math.abs(offset) <= 1 || (offset > 0 && window.scrollY >= maxScroll - 1);
    };
    const syncLocation = (active: HTMLElement, explicit: boolean) => {
      const hash = `#${active.id}`;
      if (location.hash === hash) return;
      // Without a slide hash (none, #inhalt, unknown) only a deliberate choice of Home may write #home:
      // an automatic replaceState('#home') would move the sequential focus starting point past the skip link.
      if (!explicit && active === slides[0] && slideIndexOf(location.hash) < 0) return;
      history.replaceState(null, '', hash);
      knownHash = hash;
    };
    const updateActive = (sync: 'none' | 'auto' | 'explicit' = 'auto') => {
      const top = header?.getBoundingClientRect().bottom ?? 0;
      const active = slides.find((slide) => {
        const bounds = slide.getBoundingClientRect();
        return bounds.top <= top + 2 && bounds.bottom > top + 2;
      }) ?? slides[0];
      currentIndex = slides.indexOf(active);
      links.forEach(link => {
        if (link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (sync !== 'none' && location.hash === knownHash) syncLocation(active, sync === 'explicit');
    };
    // A user action always wins over a pending automatic step; the scroll listener then follows the user.
    const releaseToUser = () => {
      if (navigation.mode === 'idle') return;
      navigation = { mode: 'idle' };
      clearTimeout(finishTimer);
      // The action may not scroll at all (e.g. a key without effect); still mark the visible section.
      if (!frame) frame = requestAnimationFrame(() => {
        frame = 0;
        if (navigation.mode === 'idle') updateActive();
      });
    };
    const finishNavigation = (token: number, sync: 'auto' | 'explicit' = 'explicit') => {
      if (!isCurrent(token)) return;
      navigation = { mode: 'idle' };
      clearTimeout(finishTimer);
      updateActive(sync);
    };
    // Animated slide changes and browser-driven scrolls end with the browser's scrollend event. The quiet-period
    // timer is restarted by every scroll event: a safety net with scrollend, the main signal without it.
    const quietPeriod = 'onscrollend' in window ? 1000 : 200;
    const finishWhenScrollSettles = (token: number) => {
      clearTimeout(finishTimer);
      finishTimer = window.setTimeout(() => finishNavigation(token, navigation.mode === 'following' ? 'auto' : 'explicit'), quietPeriod);
    };
    // Stops a running smooth scroll and holds a slide below the header until the position is stable.
    // An instant scrollTo cancels the browser's animation, but the compositor may already have moved a few
    // pixels beyond what scrollY reported, so the position is re-checked and corrected frame by frame.
    const holdPosition = (index: number, token: number) => {
      let stableFrames = 0;
      let frames = 0;
      const step = () => {
        if (!isCurrent(token)) return;
        if (frames === 0 || !isAtSlide(index)) {
          window.scrollTo({ top: window.scrollY + offsetOf(slides[index]), behavior: 'instant' });
          stableFrames = 0;
        } else {
          stableFrames += 1;
        }
        if (stableFrames >= 3 || ++frames > 120) finishNavigation(token);
        else requestAnimationFrame(step);
      };
      step();
    };
    // The latest deliberate target wins: a new call replaces or cancels a running scroll animation.
    const goToSlide = (targetIndex: number) => {
      currentIndex = Math.max(0, Math.min(targetIndex, slides.length - 1));
      const token = ++navigationToken;
      navigation = { mode: 'animating', token, target: currentIndex };
      clearTimeout(finishTimer);
      const offset = offsetOf(slides[currentIndex]);
      // Already at the target (e.g. Skills, then Home within a few ms): an earlier smooth scroll may still be
      // running without having moved yet, so it must be cancelled instead of simply finishing.
      if (Math.abs(offset) <= 1) {
        holdPosition(currentIndex, token);
        return;
      }
      window.scrollTo({ top: window.scrollY + offset, behavior: getScrollBehavior() });
      finishWhenScrollSettles(token);
    };

    const onWheel = (event: WheelEvent) => {
      const target = event.target as HTMLElement | null;
      if (!canUsePresentation() || event.ctrlKey || event.metaKey || document.querySelector('dialog[open]')
        || target?.closest('textarea, input, select, .site-header')) {
        releaseToUser();
        return;
      }
      // Remaining wheel/trackpad inertia of the gesture that already started this slide change.
      if (navigation.mode === 'animating') {
        event.preventDefault();
        return;
      }
      releaseToUser();
      const bounds = slides[currentIndex].getBoundingClientRect();
      const footerHeight = document.querySelector<HTMLElement>('.site-footer')?.offsetHeight ?? 0;
      if ((event.deltaY > 0 && bounds.bottom > window.innerHeight - footerHeight + 2)
        || (event.deltaY < 0 && bounds.top < (header?.offsetHeight ?? 0) - 2)) return;
      wheelDelta += event.deltaY;
      clearTimeout(wheelResetTimer);
      wheelResetTimer = window.setTimeout(() => { wheelDelta = 0; }, 120);
      if (Math.abs(wheelDelta) < 80) return;
      event.preventDefault();
      goToSlide(currentIndex + (wheelDelta > 0 ? 1 : -1));
      wheelDelta = 0;
    };

    const presentationKeyTarget = (event: KeyboardEvent) => {
      if (!canUsePresentation() || document.querySelector('dialog[open]')) return null;
      const target = event.target as HTMLElement | null;
      if (target && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A'].includes(target.tagName))) return null;
      if (event.key === 'ArrowDown' || event.key === 'PageDown' || event.key === ' ') return currentIndex + 1;
      if (event.key === 'ArrowUp' || event.key === 'PageUp') return currentIndex - 1;
      if (event.key === 'Home') return 0;
      if (event.key === 'End') return slides.length - 1;
      return null;
    };
    const onKeyDown = (event: KeyboardEvent) => {
      const targetIndex = presentationKeyTarget(event);
      // Every other key (native scrolling, Tab, Enter on the skip link, …) is a user action.
      if (targetIndex === null) {
        releaseToUser();
        return;
      }
      event.preventDefault();
      // A held key must not race through all slides while the animation is still running.
      if (event.repeat && navigation.mode === 'animating') return;
      goToSlide(targetIndex);
    };

    window.addEventListener('scroll', () => {
      // Scroll events during an automatic step are programmatic; user input has already released it.
      if (navigation.mode === 'animating' || navigation.mode === 'following') finishWhenScrollSettles(navigation.token);
      if (navigation.mode !== 'idle' || frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (navigation.mode === 'idle') updateActive();
      });
    }, { passive: true });
    window.addEventListener('hashchange', () => {
      knownHash = location.hash;
      const targetIndex = slideIndexOf(location.hash);
      if (targetIndex >= 0) {
        goToSlide(targetIndex);
        return;
      }
      const token = ++navigationToken;
      navigation = { mode: 'following', token };
      finishWhenScrollSettles(token);
    });
    window.addEventListener('scrollend', () => {
      // A replaced or cancelled animation may still report its end: only a reached target finishes the current one.
      if (navigation.mode === 'animating' && isAtSlide(navigation.target)) finishNavigation(navigation.token);
      else if (navigation.mode === 'following') finishNavigation(navigation.token, 'auto');
    });
    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKeyDown);
    // Mouse, pen and touch (including the start of a touch scroll) are user actions.
    window.addEventListener('pointerdown', releaseToUser, { passive: true });

    links.forEach(link => link.addEventListener('click', event => {
      if (!link.hash || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const targetIndex = slideIndexOf(link.hash);
      if (targetIndex < 0) return;
      event.preventDefault();
      goToSlide(targetIndex);
    }));

    const initialIndex = slideIndexOf(location.hash);
    if (initialIndex >= 0) {
      // Re-align a slide hash once fonts and images have settled the layout, unless the user acted first.
      currentIndex = initialIndex;
      const token = ++navigationToken;
      navigation = { mode: 'aligning', token };
      // The browser's own fragment scroll may still be animating (scroll-behavior: smooth) and would add its
      // remaining distance to a single instant scroll, so the position is held frame by frame.
      const alignInitialSection = () => holdPosition(initialIndex, token);
      const alignAfterFonts = () => { void document.fonts.ready.then(alignInitialSection, alignInitialSection); };
      if (document.readyState === 'complete') alignAfterFonts();
      else window.addEventListener('load', alignAfterFonts, { once: true });
    } else {
      // Automatic start-up only marks the active menu entry; it never rewrites the URL.
      updateActive('none');
    }
  }

</script>

<script>
  import emailjs from '@emailjs/browser';

  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const contactStatus = document.querySelector<HTMLElement>('[data-contact-status]');

  if (contactForm && contactStatus) {
    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        return;
      }

      const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!submitButton) throw new Error('Der Senden-Button des Kontaktformulars fehlt.');

      submitButton.disabled = true;
      contactStatus.textContent = 'Nachricht wird gesendet …';
      contactStatus.dataset.state = 'pending';

      try {
        await emailjs.sendForm('service_85uq3rn', 'template_xydiaar', contactForm, {
          publicKey: 'QhemBjtENsSglwf7j',
        });
        contactForm.reset();
        contactStatus.textContent = 'Vielen Dank! Deine Nachricht wurde gesendet.';
        contactStatus.dataset.state = 'success';
      } catch (error) {
        console.error('EmailJS konnte die Kontaktanfrage nicht senden.', error);
        contactStatus.textContent = 'Die Nachricht konnte nicht gesendet werden. Bitte versuche es später erneut.';
        contactStatus.dataset.state = 'error';
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
