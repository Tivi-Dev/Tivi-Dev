---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import { skillGroups } from '../lib/skill-groups';
import AboutProfile from '../components/AboutProfile.astro';
import { withBasePath } from '../lib/site-url';
import { imageShadowStyle, textShadowStyle } from '../lib/shadows';

const aboutEntry = await getEntry('ueberMich', 'ueber-mich');
if (!aboutEntry) throw new Error('Die Über-mich-Inhalte fehlen.');
const aboutPage = aboutEntry.data;
const homepage = await getEntry('homepage', 'homepage');
if (!homepage) throw new Error('Die Startseiten-Inhalte fehlen.');
const skills = await getEntry('skills', 'skills');
const contactPage = await getEntry('kontakt', 'kontakt');
const contactHeading = contactPage?.data.heading ?? 'Schreib mir eine Nachricht';
const skillCards = await getCollection('skillCards');
const projectCards = await getCollection('projectCards');
const { title, description, photo, photoAlt, photoSettings, content } = homepage.data;
const photoAspect = photoSettings.shape === 'circle' ? '1 / 1'
  : { portrait: '4 / 5', square: '1 / 1', landscape: '4 / 3' }[photoSettings.aspect];
const photoRadius = { rounded: '16px', rectangle: '0', circle: '50%' }[photoSettings.shape];
const photoStyle = `--photo-width: ${photoSettings.size}%; --photo-aspect: ${photoAspect}; --photo-radius: ${photoRadius}; --photo-zoom: ${photoSettings.zoom / 100}; --photo-x: ${photoSettings.positionX}%; --photo-y: ${photoSettings.positionY}%; ${imageShadowStyle(photoSettings.shadowIntensity)}`;

const skillCardMap = new Map(skillCards.map(card => [card.id, card]));
const skillSections = skillGroups.map(group => ({
  ...group,
  cards: [...new Set(skills?.data[group.id] ?? [])].flatMap(id => {
    const card = skillCardMap.get(id);
    if (!card) {
      console.warn(`Skills / ${group.title}: Die zugewiesene Karte „${id}“ fehlt und wird übersprungen. Bitte die Zuordnung in Keystatic prüfen.`);
      return [];
    }
    return [card];
  }),
}));
---
<BaseLayout title={title} description={description} presentation>
  <section id="home" class="home-split slide" aria-label="Home">
    <h2 class="page-title" data-shadow-text="heading-home">Home</h2>
    <div class="home-text">
      <div class="prose home-content">
        {content.map(line => {
          const className = `home-line home-line--${line.style}`;
          const style = [
            `--space-before: ${line.spaceBefore}px`,
            `--space-after: ${line.spaceAfter}px`,
            line.fontSize ? `--line-font-size: ${line.fontSize}px` : '',
            line.bold ? 'font-weight: 800' : '',
            line.italic ? 'font-style: italic' : '',
            line.underline ? 'text-decoration: underline' : '',
            textShadowStyle(line.shadowIntensity),
          ].filter(Boolean).join('; ');
          if (line.style === 'heading1') return <h1 class={className} style={style}>{line.text}</h1>;
          if (line.style === 'heading2') return <h2 class={className} style={style}>{line.text}</h2>;
          if (line.style === 'heading3') return <h3 class={className} style={style}>{line.text}</h3>;
          return <p class={className} style={style}>{line.text}</p>;
        })}
      </div>
    </div>
    <div class="home-photo" style={photoStyle}>
      {photo ? (
        <img src={withBasePath(photo)} alt={photoAlt ?? ''} width="800" height="1000" fetchpriority="high" />
      ) : (
        <div class="photo-placeholder" aria-hidden="true"></div>
      )}
    </div>
  </section>
  <section id="skills" class="slide skills-slide" aria-labelledby="skills-title">
    <h2 id="skills-title" class="page-title" data-shadow-text="heading-skills">Skills</h2>
    <div class="skills-groups">
      {skillSections.map(group => (
        <section class="skills-area" data-skill-group={group.id} aria-labelledby={`skills-${group.id}-title`}>
          <h3 id={`skills-${group.id}-title`} data-shadow-text={`heading-skills-${group.id}`}>{group.title}</h3>
          <ul class="skill-list" role="list" aria-labelledby={`skills-${group.id}-title`}>
            {group.cards.map(card => <SkillCard card={card} />)}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <section id="projekte" class="slide text-slide projects-slide" aria-labelledby="projekte-title">
    <div>
      <h2 id="projekte-title" class="page-title" data-shadow-text="heading-projekte">Projekte</h2>
      <div class="project-cards">
        {projectCards.map(card => <ProjectCard card={card} />)}
      </div>
    </div>
  </section>
  <section id="ueber-mich" class="slide text-slide about-slide" aria-labelledby="ueber-mich-title">
    <div>
      <h2 id="ueber-mich-title" class="page-title" data-shadow-text="heading-ueber-mich">Über Mich</h2>
      <AboutProfile photo={aboutPage.photo} photoAlt={aboutPage.photoAlt} photoShadow={aboutPage.photoShadow} topics={aboutPage.topics} />
    </div>
  </section>
  <section id="kontakt" class="slide text-slide contact-slide" aria-labelledby="kontakt-title">
    <div>
      <h2 id="kontakt-title" class="page-title" data-shadow-text="heading-kontakt">Kontakt</h2>
      <h3 id="contact-form-heading" class="contact-form-heading" style={textShadowStyle(contactPage?.data.headingShadow)}>{contactHeading}</h3>
      <form class="contact-form" data-contact-form aria-labelledby="contact-form-heading">
        <label>
          <span data-shadow-text="contact-label-name">Name</span>
          <input name="from_name" type="text" autocomplete="name" data-shadow-text="contact-input-name" required />
        </label>
        <label>
          <span data-shadow-text="contact-label-email">E-Mail-Adresse</span>
          <input name="reply_to" type="email" autocomplete="email" data-shadow-text="contact-input-email" required />
        </label>
        <label>
          <span data-shadow-text="contact-label-subject">Betreff</span>
          <input name="subject" type="text" data-shadow-text="contact-input-subject" required />
        </label>
        <label>
          <span data-shadow-text="contact-label-message">Nachricht</span>
          <textarea name="message" rows="6" data-shadow-text="contact-input-message" required></textarea>
        </label>
        <button type="submit" data-shadow-text="contact-submit">Nachricht senden</button>
        <p class="contact-form__status" data-contact-status data-shadow-text="contact-status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const presentation = document.querySelector<HTMLElement>('.presentation');
  if (presentation) {
    const slides = [...presentation.querySelectorAll<HTMLElement>('.slide')];
    if (!slides.length) throw new Error('Für den Präsentationsmodus wurden keine Slides gefunden.');

    const links = document.querySelectorAll<HTMLAnchorElement>('.site-header nav a');
    const header = document.querySelector<HTMLElement>('.site-header');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const presentationQuery = window.matchMedia('(min-width: 1101px) and (min-height: 741px) and (pointer: fine)');
    const canUsePresentation = () => presentationQuery.matches && !reducedMotionQuery.matches;
    const initialHash = location.hash;
    let pendingInitialAlignment = Boolean(initialHash);
    let frame = 0;
    let currentIndex = 0;
    let isNavigating = false;
    let unlockTimer = 0;
    let wheelDelta = 0;
    let wheelResetTimer = 0;

    const getScrollBehavior = (): ScrollBehavior => (reducedMotionQuery.matches ? 'auto' : 'smooth');
    const scrollToSection = (hash: string, behavior: ScrollBehavior) => {
      const section = document.querySelector<HTMLElement>(hash);
      if (!section) return;
      const top = section.getBoundingClientRect().top + window.scrollY - (header?.offsetHeight ?? 0);
      window.scrollTo({ top, behavior });
    };
    const goToSlide = (targetIndex: number) => {
      const nextIndex = Math.max(0, Math.min(targetIndex, slides.length - 1));
      if (isNavigating) return;
      currentIndex = nextIndex;
      isNavigating = true;
      clearTimeout(unlockTimer);
      scrollToSection(`#${slides[currentIndex].id}`, getScrollBehavior());
      unlockTimer = window.setTimeout(() => {
        isNavigating = false;
        updateActive();
      }, reducedMotionQuery.matches ? 80 : 650);
    };
    const navigateBy = (offset: number) => {
      goToSlide(currentIndex + offset);
    };
    const updateActive = () => {
      if (isNavigating) { frame = 0; return; }
      const top = header?.getBoundingClientRect().bottom ?? 0;
      const active = slides.find((slide) => {
        const bounds = slide.getBoundingClientRect();
        return bounds.top <= top + 2 && bounds.bottom > top + 2;
      }) ?? slides[0];
      const index = slides.indexOf(active);
      if (index >= 0) currentIndex = index;
      links.forEach(link => {
        if (link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (!pendingInitialAlignment && location.hash !== `#${active.id}`) history.replaceState(null, '', `#${active.id}`);
      frame = 0;
    };

    const onWheel = (event: WheelEvent) => {
      if (!canUsePresentation() || event.ctrlKey || event.metaKey || document.querySelector('dialog[open]')) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest('textarea, input, select, .site-header')) return;
      const bounds = slides[currentIndex].getBoundingClientRect();
      const footerHeight = document.querySelector<HTMLElement>('.site-footer')?.offsetHeight ?? 0;
      if ((event.deltaY > 0 && bounds.bottom > window.innerHeight - footerHeight + 2)
        || (event.deltaY < 0 && bounds.top < (header?.offsetHeight ?? 0) - 2)) return;
      wheelDelta += event.deltaY;
      clearTimeout(wheelResetTimer);
      wheelResetTimer = window.setTimeout(() => { wheelDelta = 0; }, 120);
      if (Math.abs(wheelDelta) < 80) return;
      event.preventDefault();
      navigateBy(wheelDelta > 0 ? 1 : -1);
      wheelDelta = 0;
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (!canUsePresentation() || document.querySelector('dialog[open]')) return;
      const target = event.target as HTMLElement | null;
      if (target && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A'].includes(target.tagName))) return;

      if (event.key === 'ArrowDown' || event.key === 'PageDown' || event.key === ' ') {
        event.preventDefault();
        navigateBy(1);
      } else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
        event.preventDefault();
        navigateBy(-1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goToSlide(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goToSlide(slides.length - 1);
      }
    };

    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(updateActive);
    }, { passive: true });
    window.addEventListener('hashchange', () => {
      const targetIndex = slides.findIndex(slide => `#${slide.id}` === location.hash);
      if (targetIndex >= 0) goToSlide(targetIndex);
    });
    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKeyDown);

    links.forEach(link => link.addEventListener('click', event => {
      if (!link.hash || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const targetIndex = slides.findIndex(slide => `#${slide.id}` === link.hash);
      if (targetIndex < 0) return;
      event.preventDefault();
      goToSlide(targetIndex);
    }));

    if (initialHash) {
      const targetIndex = slides.findIndex(slide => `#${slide.id}` === initialHash);
      if (targetIndex >= 0) {
        currentIndex = targetIndex;
        const alignInitialSection = () => {
          scrollToSection(initialHash, 'instant');
          requestAnimationFrame(() => {
            pendingInitialAlignment = false;
            updateActive();
          });
        };
        if (document.readyState === 'complete') void document.fonts.ready.then(alignInitialSection);
        else window.addEventListener('load', () => { void document.fonts.ready.then(alignInitialSection); }, { once: true });
      }
    }
    if (!initialHash) updateActive();
  }

</script>

<script>
  const contactHeading = document.querySelector<HTMLElement>('.contact-form-heading');
  if (contactHeading) {
    const fitHeading = () => {
      contactHeading.style.removeProperty('font-size');
      const availableWidth = contactHeading.clientWidth;
      if (!availableWidth || contactHeading.scrollWidth <= availableWidth) return;
      const fontSize = Number.parseFloat(getComputedStyle(contactHeading).fontSize);
      contactHeading.style.fontSize = `${fontSize * availableWidth / (contactHeading.scrollWidth + 1)}px`;
    };
    let previousWidth = 0;
    const observer = new ResizeObserver(([entry]) => {
      if (entry.contentRect.width === previousWidth) return;
      previousWidth = entry.contentRect.width;
      fitHeading();
    });
    observer.observe(contactHeading);
    void document.fonts.ready.then(fitHeading);
  }
</script>

<script>
  import emailjs from '@emailjs/browser';

  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const contactStatus = document.querySelector<HTMLElement>('[data-contact-status]');

  if (contactForm && contactStatus) {
    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        return;
      }

      const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!submitButton) throw new Error('Der Senden-Button des Kontaktformulars fehlt.');

      submitButton.disabled = true;
      contactStatus.textContent = 'Nachricht wird gesendet …';
      contactStatus.dataset.state = 'pending';

      try {
        await emailjs.sendForm('service_85uq3rn', 'template_xydiaar', contactForm, {
          publicKey: 'QhemBjtENsSglwf7j',
        });
        contactForm.reset();
        contactStatus.textContent = 'Vielen Dank! Deine Nachricht wurde gesendet.';
        contactStatus.dataset.state = 'success';
      } catch (error) {
        console.error('EmailJS konnte die Kontaktanfrage nicht senden.', error);
        contactStatus.textContent = 'Die Nachricht konnte nicht gesendet werden. Bitte versuche es später erneut.';
        contactStatus.dataset.state = 'error';
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
