---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { withBasePath } from '../lib/site-url';
import { fixedTextShadowRules, textShadowStyle } from '../lib/shadows';
import fontUrl from '../assets/fonts/Manrope-VariableFont_wght.woff2?url';
interface Props { title: string; description: string; presentation?: boolean }
const { title, description, presentation = false } = Astro.props;
const settings = (await getEntry('settings', 'settings'))?.data;
const footer = (await getEntry('footer', 'footer'))?.data;
if (!settings || !footer) throw new Error('Die Header- oder Footer-Einstellungen fehlen.');
const design = (await getEntry('design', 'design'))?.data ?? { glassIntensity: 50, shadowIntensity: 50, fixedTextShadows: [] };
const designStyle = `--glass-intensity: ${design.glassIntensity / 100}; --menu-shadow-intensity: ${design.shadowIntensity / 100}`;
const shadowRules = fixedTextShadowRules(design.fixedTextShadows);
const mainLinks = [
  { label: 'Home', href: '/#home' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Projekte', href: '/#projekte' },
  { label: 'Über Mich', href: '/#ueber-mich' },
  { label: 'Kontakt', href: '/#kontakt' },
].map(link => ({ ...link, shadowTarget: `menu-${link.href.split('#')[1]}`, href: withBasePath(link.href) }));
const defaultFooterLinks = [
  { label: 'Impressum', href: '/impressum/', shadowIntensity: null },
  { label: 'Datenschutz', href: '/datenschutz/', shadowIntensity: null },
];
const footerLinks = (footer.links.length ? footer.links : defaultFooterLinks)
  .map(link => ({ ...link, shadowTarget: ({ '/impressum/': 'footer-impressum', '/datenschutz/': 'footer-datenschutz' } as Record<string, string>)[link.href], href: withBasePath(link.href) }));
---
<!doctype html>
<html lang="de" class:list={{ 'presentation-page': presentation }} style={designStyle}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Same file as the @font-face in global.css: loading it early keeps the text from reflowing late. -->
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <title>{title}</title>
    {shadowRules && <style is:inline set:html={shadowRules} />}
  </head>
  <body class:list={{ 'presentation-page': presentation }}>
    <a class="skip-link" href="#inhalt" data-shadow-text="skip-link">Zum Inhalt</a>
    <header class="site-header" data-nav-open="false">
      <a class="site-title" href={withBasePath('/')} style={textShadowStyle(settings.titleShadow)}>{settings.websiteTitle}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" data-shadow-text="menu-toggle">Menü</button>
      <nav id="main-navigation" class="site-nav" aria-label="Hauptnavigation">
        <ul>
          {mainLinks.map(({ label, href, shadowTarget }) => (
            <li><a href={href} data-shadow-text={shadowTarget} aria-current={Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '') ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="inhalt" class:list={{ presentation }} tabindex={presentation ? 0 : undefined} aria-label={presentation ? 'Home bis Kontakt' : undefined}><slot /></main>
    <footer class="site-footer">
      <span class="footer-label" style={textShadowStyle(footer.labelShadow)}>{footer.label || 'Tivi TM'}</span>
      <nav class="site-nav" aria-label="Rechtliche Informationen">
        <ul>
          {footerLinks.map(({ label, href, shadowIntensity, shadowTarget }) => (
            <li><a href={href} data-shadow-text={shadowTarget} style={shadowIntensity == null ? undefined : textShadowStyle(shadowIntensity)} aria-current={Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '') ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const navigation = header?.querySelector<HTMLElement>('#main-navigation');
  if (header && toggle && navigation) {
    const closeMenu = () => {
      header.dataset.navOpen = 'false';
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const open = header.dataset.navOpen !== 'true';
      header.dataset.navOpen = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    });
    navigation.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) closeMenu();
    }, { capture: true });
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.dataset.navOpen === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) closeMenu();
    });
    window.matchMedia('(max-width: 1100px)').addEventListener('change', closeMenu);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    }).observe(header);
  }
  // Mobile browsers scroll a focused text field only until the caret is visible and ignore scroll-padding,
  // so the fixed footer could still cover the rest of the field. scrollIntoView honours scroll-padding.
  // Same media query as scroll-padding-bottom in global.css: on desktop, scroll snapping would fight this scroll.
  const footerPaddingQuery = window.matchMedia('(max-width: 1100px), (max-height: 740px), (pointer: coarse)');
  document.addEventListener('focusin', (event) => {
    const field = event.target;
    if (!footerPaddingQuery.matches) return;
    if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) return;
    requestAnimationFrame(() => field.scrollIntoView({ block: 'nearest' }));
  });
</script>
